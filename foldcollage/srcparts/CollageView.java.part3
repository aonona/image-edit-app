            if (distance <= bestDistance) {
                bestDistance = distance;
                best = i;
            }
        }
        return best;
    }

    private float distanceToSegment(float px, float py, float x1, float y1, float x2, float y2) {
        float dx = x2 - x1;
        float dy = y2 - y1;
        float len2 = dx * dx + dy * dy;
        if (len2 <= 0.0001f) return (float) Math.hypot(px - x1, py - y1);
        float t = ((px - x1) * dx + (py - y1) * dy) / len2;
        t = Math.max(0f, Math.min(1f, t));
        float cx = x1 + t * dx;
        float cy = y1 + t * dy;
        return (float) Math.hypot(px - cx, py - cy);
    }

    private void moveDivider(int index, float x, float y) {
        float[] pos = dividerPositions.get(preset);
        if (pos == null || index < 0 || index >= pos.length) return;

        float value;
        switch (preset) {
            case H2:
            case H3:
                value = getHeight() > 0 ? y / getHeight() : pos[index];
                break;
            default:
                value = getWidth() > 0 ? x / getWidth() : pos[index];
                break;
        }
        value = Math.max(0f, Math.min(1f, value));

        if (pos.length == 2) {
            if (index == 0) value = Math.min(value, pos[1]);
            else value = Math.max(value, pos[0]);
        }

        pos[index] = value;
        // Intentionally do not alter image zoom/offset when a divider moves.
        invalidate();
        changed();
    }

    private List<Path> buildPaths(int w, int h) {
        List<float[]> polygons = normalizedPolygons();
        List<Path> result = new ArrayList<>();
        for (float[] pts : polygons) {
            Path p = new Path();
            p.moveTo(pts[0] * w, pts[1] * h);
            for (int i = 2; i < pts.length; i += 2) {
                p.lineTo(pts[i] * w, pts[i + 1] * h);
            }
            p.close();
            result.add(p);
        }
        return result;
    }

    private List<float[]> normalizedPolygons() {
        List<float[]> p = new ArrayList<>();
        float[] d = dividerPositions.get(preset);
        switch (preset) {
            case H2: {
                float y = d[0];
                p.add(new float[]{0,0, 1,0, 1,y, 0,y});
                p.add(new float[]{0,y, 1,y, 1,1, 0,1});
                break;
            }
            case V3: {
                float x1 = d[0];
                float x2 = d[1];
                p.add(new float[]{0,0, x1,0, x1,1, 0,1});
                p.add(new float[]{x1,0, x2,0, x2,1, x1,1});
                p.add(new float[]{x2,0, 1,0, 1,1, x2,1});
                break;
            }
            case H3: {
                float y1 = d[0];
                float y2 = d[1];
                p.add(new float[]{0,0, 1,0, 1,y1, 0,y1});
                p.add(new float[]{0,y1, 1,y1, 1,y2, 0,y2});
                p.add(new float[]{0,y2, 1,y2, 1,1, 0,1});
                break;
            }
            case DIAG2_R: {
                float c = d[0];
                float top = c + .14f;
                float bottom = c - .14f;
                p.add(new float[]{0,0, top,0, bottom,1, 0,1});
                p.add(new float[]{top,0, 1,0, 1,1, bottom,1});
                break;
            }
            case DIAG2_L: {
                float c = d[0];
                float top = c - .14f;
                float bottom = c + .14f;
                p.add(new float[]{0,0, top,0, bottom,1, 0,1});
                p.add(new float[]{top,0, 1,0, 1,1, bottom,1});
                break;
            }
            case DIAG3_R: {
                float c1 = d[0];
                float c2 = d[1];
                float top1 = c1 + .10f;
                float bottom1 = c1 - .10f;
                float top2 = c2 + .10f;
                float bottom2 = c2 - .10f;
                p.add(new float[]{0,0, top1,0, bottom1,1, 0,1});
                p.add(new float[]{top1,0, top2,0, bottom2,1, bottom1,1});
                p.add(new float[]{top2,0, 1,0, 1,1, bottom2,1});
                break;
            }
            case V2:
            default: {
                float x = d[0];
                p.add(new float[]{0,0, x,0, x,1, 0,1});
                p.add(new float[]{x,0, 1,0, 1,1, x,1});
                break;
            }
        }
        return p;
    }

    private List<DividerSegment> dividerSegments(int w, int h) {
        List<DividerSegment> result = new ArrayList<>();
        float[] d = dividerPositions.get(preset);
        switch (preset) {
            case H2:
                result.add(new DividerSegment(0, d[0] * h, w, d[0] * h));
                break;
            case V3:
                result.add(new DividerSegment(d[0] * w, 0, d[0] * w, h));
                result.add(new DividerSegment(d[1] * w, 0, d[1] * w, h));
                break;
            case H3:
                result.add(new DividerSegment(0, d[0] * h, w, d[0] * h));
                result.add(new DividerSegment(0, d[1] * h, w, d[1] * h));
                break;
            case DIAG2_R:
                result.add(new DividerSegment((d[0] + .14f) * w, 0, (d[0] - .14f) * w, h));
                break;
            case DIAG2_L:
                result.add(new DividerSegment((d[0] - .14f) * w, 0, (d[0] + .14f) * w, h));
                break;
            case DIAG3_R:
                result.add(new DividerSegment((d[0] + .10f) * w, 0, (d[0] - .10f) * w, h));
                result.add(new DividerSegment((d[1] + .10f) * w, 0, (d[1] - .10f) * w, h));
                break;
            case V2:
            default:
                result.add(new DividerSegment(d[0] * w, 0, d[0] * w, h));
                break;
        }
        return result;
    }

    private float[] defaultDividers(Preset p) {
        switch (p) {
            case V3:
            case H3:
                return new float[]{1f / 3f, 2f / 3f};
            case DIAG3_R:
                return new float[]{.33f, .66f};
            default:
                return new float[]{.5f};
        }
    }

    private void changed() {
        if (listener != null) listener.onStateChanged();
    }
}
